{
    "maven.terminal.favorites": [
        {
            "alias": "Gemini 2.5 Flash Lite",
            "command": "spring-boot:run -P gemini -Dspring-boot.run.jvmArguments=\"-DGEMINI_MODEL=gemini-2.5-flash-lite\"",
            "debug": false
        },
        {
            "alias": "Gemini 3.1 Flash Lite",
            "command": "spring-boot:run -P gemini -Dspring-boot.run.jvmArguments=\"-DGEMINI_MODEL=gemini-3.1-flash-lite\"",
            "debug": false
        },
        {
            "alias": "Gemma 4 26b",
            "command": "spring-boot:run -P gemini -Dspring-boot.run.jvmArguments=\"-DGEMINI_MODEL=gemma-4-26b-a4b-it\"",
            "debug": false
        },
        {
            "alias": "Gemma 4 31b",
            "command": "spring-boot:run -P gemini -Dspring-boot.run.jvmArguments=\"-DGEMINI_MODEL=gemma-4-31b-it\"",
            "debug": false
        },
        {
            "alias": "Ollama",
            "command": "spring-boot:run -P ollama -Dspring-boot.run.jvmArguments=\"-DOLLAMA_MODEL=functiongemma\"",
            "debug": false
        }
    ],
    "java.compile.nullAnalysis.mode": "automatic",
    "java.configuration.updateBuildConfiguration": "automatic",
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        ".mule": true
    }
}